def tas(lk) returns oldvalue:
    atomically:
        oldvalue = !lk
        !lk = True
    
def Lock() returns init_value:
    init_value = False

def lock(lk):
    while tas(lk):
        pass

def unlock(lk):
    !lk = False

def Condition(lk) returns init_value:
    init_value = { .lock: lk, .waiters: {} }

def wait(c):
    var lk = None
    atomically:
        lk = c->lock
        c->waiters += { nametag() }
        !lk = False
    atomically when (not (!lk)) and (not ((nametag()) in c->waiters)):
        !lk = True

def notify(c):
    atomically let waiters = c->waiters:
        if waiters != {}:
            c->waiters = waiters - { choose(waiters) }
            
def notify_all(c):
    c->waiters = {}

# Deprecated
def notifyAll(c):
    c->waiters = {}

def Semaphore(cnt) returns init_value:
    init_value = cnt

def P(sema):
    atomically when (!sema) > 0:
        !sema -= 1

def V(sema):
    atomically !sema += 1
