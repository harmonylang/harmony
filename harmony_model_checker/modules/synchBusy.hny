def tas(lk) returns oldvalue:
    atomically:
        oldvalue = !lk
        !lk = True

def Lock() returns init_value:
    init_value = False

def lock(lk):
    while tas(lk):
        pass

def unlock(lk):
    !lk = False

def Condition(lk) returns init_value:
    init_value = lk

def wait(c):
    unlock(!c)
    lock(!c)

def notify(c):
    pass

def notify_all(c):
    pass

# Deprecated
def notifyAll(c):
    pass

def Semaphore(cnt) returns init_value:
    init_value = cnt

def P(sema):
    atomically when !sema > 0:
        !sema -= 1
                
def V(sema):
    atomically !sema += 1
