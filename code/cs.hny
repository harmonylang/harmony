# number of threads in the critical section
global in_cs
invariant in_cs in { 0, 1 }
in_cs = 0

def thread():
    while choose { False, True }:
        # Enter critical section
        atomically in_cs += 1

        # Critical section is here
        pass

        # Exit critical section
        atomically in_cs -= 1
    
spawn thread()
spawn thread()
