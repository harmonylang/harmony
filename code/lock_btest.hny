from locks import Lock, acquire, release

const NTHREADS = 2

global the_lock
the_lock = Lock()

def thread(self):
    while choose { False, True }:
        acquire(?the_lock)
        print("enter", self)
        # Critical section: self is here
        print("exit", self)
        release(?the_lock)

for i in { 1 .. NTHREADS }:
    spawn thread(i)
