from synch import Lock, acquire, release

sequential done
done = [ False, False ]

global count, countlock
count = 0
countlock = Lock()

def thread(self):
    acquire(?countlock)
    count = count + 1
    release(?countlock)
    done[self] = True
    await done[1 - self]
    assert count == 2

spawn thread(0)
spawn thread(1)
